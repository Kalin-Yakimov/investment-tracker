# Local default: http://localhost:8080
VITE_API_URL=http://localhost:8080

# Wait after the last typed character before searching the CS item catalogue.
VITE_ITEM_SEARCH_DEBOUNCE_MS=1000

# Production example:
# Use the same public origin as the website, backed by the /api/ proxy.
# VITE_API_URL=https://tracker.example.com
# Deployment build: npm.cmd run build:production (explicit HTTPS origin required).
