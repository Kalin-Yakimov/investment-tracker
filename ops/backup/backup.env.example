# Copy outside the repository. File mode 600; never enable shell tracing.
BACKUP_DATABASE=investment
BACKUP_HOST=investment-production-1
BACKUP_STATE_DIRECTORY=/var/lib/investment-backup
MYSQL_BACKUP_DEFAULTS_FILE=/etc/investment-backup/mysql.cnf
RESTIC_REPOSITORY=s3:https://storage.example.invalid/private-backups/investment
RESTIC_PASSWORD_FILE=/etc/investment-backup/restic-password
# Backend-specific credentials are supplied separately, e.g. AWS_ACCESS_KEY_ID
# and AWS_SECRET_ACCESS_KEY. Never put credentials inside a repository URL.
