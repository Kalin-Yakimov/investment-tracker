# Reference single-host topology, NOT installed automatically.
# Replace domain, certificate and root; nginx -t before any reload.
# Include inside the http {} context. Use only maintained NGINX/OpenSSL packages.
server_tokens off;
# Deliberately omit URI/query, cookies, Authorization, IP and request bodies.
log_format investment_minimal '$time_iso8601 status=$status method=$request_method bytes=$body_bytes_sent duration=$request_time requestId=$upstream_http_x_request_id';

server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name tracker.example.invalid;
    return 308 https://tracker.example.invalid$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}
server {
    listen 443 ssl;
    server_name tracker.example.invalid;
    ssl_certificate /etc/investment/tls/fullchain.pem;
    ssl_certificate_key /etc/investment/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/investment/current/frontend;
    index index.html;
    client_max_body_size 64k;
    client_body_timeout 10s;
    access_log /var/log/nginx/investment-access.log investment_minimal;

    include /etc/nginx/snippets/investment-security-headers.conf;

    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }
    location ^~ /swagger-ui { return 404; }
    location ^~ /v3/api-docs { return 404; }
    location ~ /\. { return 404; }
    # Include all existing backend contracts, including legacy Portfolio routes.
    location /api/ { include /etc/nginx/snippets/investment-api-proxy.conf; }
    location = /item { include /etc/nginx/snippets/investment-api-proxy.conf; }
    location /item/ { include /etc/nginx/snippets/investment-api-proxy.conf; }
    location = /get-user-items { include /etc/nginx/snippets/investment-api-proxy.conf; }
    location = /portfolio-summary { include /etc/nginx/snippets/investment-api-proxy.conf; }
    location /cs-items/ { include /etc/nginx/snippets/investment-api-proxy.conf; }
    location = /items/search { include /etc/nginx/snippets/investment-api-proxy.conf; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
