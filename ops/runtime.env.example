# Copy outside Git to /etc/investment/runtime.env, owner root, mode 600.
# systemd EnvironmentFile syntax, not a shell script. No "export".
DB_URL=jdbc:mysql://127.0.0.1:3306/investment
DB_USERNAME=investment_app
DB_PASSWORD=replace_with_private_database_secret
MAIL_USERNAME=replace_with_project_email
MAIL_PASSWORD=replace_with_private_app_password
JWT_SECRET=replace_with_random_base64_of_at_least_32_bytes
JWT_ISSUER=investment-production
JWT_AUDIENCE=investment-browser-production
APP_FRONTEND_URL=https://tracker.example.invalid
CORS_ALLOWED_ORIGINS=https://tracker.example.invalid
ADMIN_EMAIL=
