# Copy these names into your local environment. Never commit real values.
DB_URL=jdbc:mysql://localhost:3306/investment
DB_USERNAME=root
DB_PASSWORD=replace_with_your_database_password
MAIL_USERNAME=replace_with_your_gmail_address
MAIL_PASSWORD=replace_with_a_gmail_app_password
JWT_SECRET=replace_with_a_base64_encoded_secret_of_at_least_32_bytes

# Local development defaults
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_SECURE=false

# Production should use HTTPS and the exact frontend origin.
# AUTH_COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://example.com
# JPA_DDL_AUTO=validate
# Existing account that receives the initial ADMIN role at application startup.
ADMIN_EMAIL=admin@example.com

# Optional external-service limits (defaults shown; these are not secrets).
EXTERNAL_HTTP_CONNECT_TIMEOUT=5s
EXTERNAL_HTTP_READ_TIMEOUT=20s
EXTERNAL_HTTP_MAXIMUM_RESPONSE_BYTES=33554432
PRICE_FEED_CHECK_INTERVAL_MS=7200000
PRICE_FEED_FAILURE_RETRY_INTERVAL_MS=60000
PRICE_FEED_REFRESH_WAIT_MS=25000
PRICE_FEED_MAXIMUM_DECODED_BYTES=67108864
